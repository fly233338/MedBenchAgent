{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medbenchagent.local/schemas/annotation.v2.schema.json",
  "title": "Entity-scoped image annotation JSONL record v2",
  "type": "object",
  "required": ["patient", "case", "study", "image"],
  "properties": {
    "patient": {
      "type": "object",
      "required": ["patient_id", "annotation"],
      "properties": {
        "patient_id": {"type": ["string", "null"], "minLength": 1},
        "annotation": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["case_id", "annotation"],
      "properties": {
        "case_id": {"type": ["string", "null"], "minLength": 1},
        "annotation": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "study": {
      "type": "object",
      "required": ["study_id", "annotation"],
      "properties": {
        "study_id": {"type": ["string", "null"], "minLength": 1},
        "annotation": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": ["image_id", "image_path", "modality", "anatomy", "annotation"],
      "properties": {
        "image_id": {"type": "string", "minLength": 1},
        "image_path": {"type": "string", "minLength": 1},
        "modality": {"type": ["string", "null"], "minLength": 1},
        "anatomy": {"type": ["string", "null"], "minLength": 1},
        "annotation": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
