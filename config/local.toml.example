# New runs freeze these settings. Credentials stay in .env or environment variables.
[llm]
# model = "your-chat-model"
# base_url = "http://127.0.0.1:8005/v1"
reasoning_effort = "medium"

[benchmark]
default_sample_count = 1000
default_language = "en"

[coding]
worker_venv = ".venv-coding" # Provision separately using config/coding-worker.requirements.txt.
[coding.llm]
# model = "your-coding-model"
# Omitted values inherit [llm]. MEDBENCH_CODING_LLM_API_KEY can supply a separate key.

[compilation.repair_limits]
per_problem = 3
no_progress = 3
total = 12

[planner]
page_size = 20
preview_chars = 6000
[planner.loop]
max_model_calls = 60
max_tool_calls = 120

[data_processing_agent.loop]
max_model_calls = 40
max_tool_calls = 80
[generation_agent]
page_size = 64
[review_agent.loop]
max_model_calls = 40
max_tool_calls = 80
