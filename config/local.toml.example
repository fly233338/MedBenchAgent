# Copy to config/local.toml and pass --config config/local.toml before the CLI command.
# This seeds NEW experiments only; experiment BIR state lives under experiments/<name>/BIR.
# Relative data paths resolve from the repository root. Nonempty supported environment
# variables override TOML for new runs; resume uses frozen settings. Keep credentials in .env
# or process environment variables (see .env.example).

# Optional raw sources. Prepared datasets continue to use paths.dataset_catalog.
# [[dataset_sources]]
# dataset_id = "example"
# name = "Example dataset"
# description = "Describe the actual dataset population and modality for discovery."
# [[dataset_sources.sources]]
# id = "original"
# root = "D:/Data/example"
# kind = "raw" # use annotation for existing canonical cases.jsonl
# annotation = "cases.jsonl"

[benchmark]
default_sample_count = 1000 # Used only when the user did not supply a count; language is asked.

# [llm]
# model = "your-chat-model" # Optional when /v1/models returns exactly one model.
reasoning_effort = "medium" # Must be supported by the configured gateway/model.

[rag]
embedding_base_url = "http://127.0.0.1:8001/v1"
# embedding_model = "Qwen/Qwen3-Embedding-0.6B" # Required only for multi-model endpoints.
reranker_base_url = "http://127.0.0.1:8002/v1"
# reranker_model = "Qwen/Qwen3-Reranker-0.6B"

[generation]
# Number of semantically equivalent question templates per Leaf Task (3-5).
question_template_count = 3

# [data_processing]
# backend = "local"  # auto, docker, or local
# coding_worker_image = "medbench-openhands:local"
# preparation_no_progress_limit = 8
# preparation_tool_error_limit = 3
