# Copy to config/local.toml and pass --config config/local.toml before the CLI command.
# This seeds NEW experiments only; each compilation owns experiments/<name>/compilations/<id>/BIR/.
# Relative data paths resolve from the repository root. Nonempty supported environment
# variables override TOML for new runs; resume uses frozen settings. Keep credentials in .env
# or process environment variables (see .env.example).

# Optional raw sources. Prepared datasets continue to use paths.dataset_catalog.
# [[dataset_sources]]
# dataset_id = "example"
# name = "Example dataset"
# description = "Describe the actual dataset population and modality for discovery."
# [[dataset_sources.sources]]
# id = "original"
# root = "D:/Data/example"
# kind = "raw" # use annotation for existing canonical cases.jsonl
# annotation = "cases.jsonl"

[benchmark]
default_sample_count = 1000 # Used only when the user did not supply a count; language defaults to English.

[llm]
# model = "your-chat-model" # Optional when /v1/models returns exactly one model.
reasoning_effort = "medium" # Must be supported by the configured gateway/model.

# Native Planner uses the common [llm]; only enabled roles are loaded and frozen.
[planner]
page_size = 20
preview_chars = 6000
max_scenarios = 10000

[planner.loop]
max_model_calls = 60
max_tool_calls = 120

# New professional agents use the common [llm], independently frozen when enabled.
[data_processing_agent.loop]
max_model_calls = 40
max_tool_calls = 80

[generation_agent]
page_size = 64 # Also bounds a generation batch request.

[review_agent.loop]
max_model_calls = 40
max_tool_calls = 80

# Independent Compilation Coding settings; not the old Preparation runtime.
[coding]
worker_venv = ".venv-coding" # Must already be provisioned; no automatic installation.

[coding.llm]
# Omitted fields inherit the common [llm] after common environment overrides.
# model = "your-coding-model"
# base_url = "http://127.0.0.1:8005/v1"
# Set MEDBENCH_CODING_LLM_API_KEY in the environment for a separate credential.

[rag]
embedding_base_url = "http://127.0.0.1:8001/v1"
# embedding_model = "Qwen/Qwen3-Embedding-0.6B" # Required only for multi-model endpoints.
reranker_base_url = "http://127.0.0.1:8002/v1"
# reranker_model = "Qwen/Qwen3-Reranker-0.6B"

[generation]
# Number of semantically equivalent question templates per Leaf Task (3-5).
question_template_count = 3

# [data_processing]
# backend = "local"  # auto, docker, or local
# coding_worker_image = "medbench-openhands:local"
# coding_worker_venv = ".venv-coding"  # local backend; startup provisions this environment
# preparation_attempt_limits = { understand = 2, prepare_text = 2, prepare_image = 2, mapping_revision_cycles = 1 }
