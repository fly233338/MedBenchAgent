# OpenAI-compatible endpoint. The vLLM deployment uses its /v1 API prefix.
# Optional when the local vLLM server does not enable API-key authentication.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=http://127.0.0.1:8005/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Local directories for guideline retrieval models.
BGE_EMBEDDING_MODEL=/public/home/rxa-jj-wzk/models/Qwen-RAG/Qwen3-Embedding-0.6B
BGE_RERANKER_MODEL=/public/home/rxa-jj-wzk/models/Qwen-RAG/Qwen3-Reranker-0.6B
