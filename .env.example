# Optional explicit local TOML override; relative paths are resolved from the project root.
MEDBENCH_CONFIG=config/local.toml

# Sensitive values remain environment variables. The API key is optional for unauthenticated vLLM.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=
DEEPSEEK_TIMEOUT_SECONDS=

# Optional LangSmith tracing. Set this to true and provide an API key to upload traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medbenchagent

# Optional non-sensitive overrides for local retrieval models and threshold.
BGE_EMBEDDING_MODEL=
BGE_RERANKER_MODEL=
RAG_MIN_RERANK_SCORE=
