# Optional override for direct configuration consumers (register/refresh-card).
# CLI --config seeds NEW experiments; existing experiments use their own config.toml.
# Relative data paths and MEDBENCH_CONFIG resolve from the repository root.
# MEDBENCH_CONFIG=config/local.toml

# Process variables take precedence over .env; empty field overrides are ignored.
# Common Chat and RAG keys default to local-vllm when unset.
MEDBENCH_LLM_API_KEY=
# Independent Compilation Coding: omit to reuse MEDBENCH_LLM_API_KEY.
MEDBENCH_CODING_LLM_API_KEY=
MEDBENCH_LLM_MODEL= # Optional explicit choice for a multi-model Chat endpoint.
MEDBENCH_LLM_BASE_URL=
MEDBENCH_LLM_MAX_RETRIES=
MEDBENCH_LLM_TIMEOUT_SECONDS=

# RAG endpoints and optional multi-model overrides belong in [rag] in the experiment TOML.
MEDBENCH_EMBEDDING_API_KEY=
MEDBENCH_RERANKER_API_KEY=
RAG_MIN_RERANK_SCORE=

# Direct library/graph use only: CLI/TUI entrypoints disable external tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medbenchagent
