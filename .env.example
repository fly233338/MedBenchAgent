# Optional configuration override for new standalone runs and library consumers.
# CLI --config configures new standalone runs or seeds new experiments.
# Existing experiments use their own config.toml for new runs; resumes use frozen snapshots.
# MEDBENCH_CONFIG resolves from the checkout root; installed wheels use the launch directory.
# Data references resolve relative to their manifest.
# MEDBENCH_CONFIG=config/local.toml

# Process variables take precedence over .env; empty field overrides are ignored.
# Common Chat and RAG keys default to local-vllm when unset.
MEDBENCH_LLM_API_KEY=
# Data Processing's independent Coding environment: omit to reuse MEDBENCH_LLM_API_KEY.
MEDBENCH_CODING_LLM_API_KEY=
MEDBENCH_LLM_MODEL= # Optional explicit choice for a multi-model Chat endpoint.
MEDBENCH_LLM_BASE_URL=
MEDBENCH_LLM_MAX_RETRIES=
MEDBENCH_LLM_TIMEOUT_SECONDS=

# RAG endpoints and optional multi-model overrides belong in [rag] in the selected TOML.
MEDBENCH_EMBEDDING_API_KEY=
MEDBENCH_RERANKER_API_KEY=
RAG_MIN_RERANK_SCORE=

# Optional LangChain tracing; disabled by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medbenchagent
