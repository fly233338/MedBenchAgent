{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medbenchagent.local/schemas/annotation.schema.json",
  "title": "MedD2B annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "evidence"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "patient_id": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "value"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["value", "text", "asset", "region"]},
        "name": {"type": "string", "minLength": 1},
        "value": {},
        "time": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "ref": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "mask": {"anyOf": [{"$ref": "#/$defs/maskFeatureSet"}, {"type": "null"}]},
        "view_id": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "text"}}}, "then": {"properties": {"value": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "asset"}}}, "then": {"properties": {"value": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"type": {"const": "region"}}}, "then": {"properties": {"value": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}}}},
        {"if": {"properties": {"type": {"const": "value"}}}, "then": {"not": {"required": ["unit"], "properties": {"unit": {"type": "null"}}}}},
        {"if": {"required": ["unit"]}, "then": {"properties": {"type": {"const": "value"}}}},
        {"if": {"required": ["mask"]}, "then": {"properties": {"type": {"const": "asset"}}}}
      ]
    },
    "normalizedBbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "maskPlaneFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "index", "bbox", "pixel_count", "area_fraction", "centroid", "equivalent_diameter_pixels"],
      "properties": {
        "axis": {"type": "integer", "minimum": 0},
        "index": {"type": "integer", "minimum": 0},
        "bbox": {"$ref": "#/$defs/normalizedBbox"},
        "pixel_count": {"type": "integer", "exclusiveMinimum": 0},
        "area_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "centroid": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "equivalent_diameter_pixels": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "maskFeatureSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_digest", "algorithm", "channel", "foreground", "shape", "bbox", "pixel_count", "area_fraction", "centroid", "component_count", "equivalent_diameter_pixels", "planes"],
      "properties": {
        "source_digest": {"type": "string", "minLength": 1},
        "algorithm": {"type": "string", "minLength": 1},
        "channel": {"enum": ["red", "green", "blue", "alpha", "luminance", "any"]},
        "foreground": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 255}, "uniqueItems": true},
        "shape": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "integer", "exclusiveMinimum": 0}},
        "bbox": {"$ref": "#/$defs/normalizedBbox"},
        "pixel_count": {"type": "integer", "exclusiveMinimum": 0},
        "area_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "centroid": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "component_count": {"type": "integer", "exclusiveMinimum": 0},
        "equivalent_diameter_pixels": {"type": "number", "exclusiveMinimum": 0},
        "spacing": {"type": ["array", "null"], "minItems": 2, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
        "physical_area": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "physical_unit": {"type": ["string", "null"], "minLength": 1},
        "planes": {"type": "array", "items": {"$ref": "#/$defs/maskPlaneFeature"}}
      },
      "allOf": [
        {"if": {"properties": {"shape": {"minItems": 3, "maxItems": 3}}},
         "then": {"properties": {"planes": {"items": {"properties": {"axis": {"const": 2}}}}}}}
      ]
    }
  }
}

