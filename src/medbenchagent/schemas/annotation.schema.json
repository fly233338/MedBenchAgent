{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medbenchagent.local/schemas/annotation.schema.json",
  "title": "MedBenchAgent annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "evidence"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "patient_id": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "value"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["value", "text", "asset", "region"]},
        "name": {"type": "string", "minLength": 1},
        "value": {},
        "time": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "ref": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "text"}}}, "then": {"properties": {"value": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "asset"}}}, "then": {"properties": {"value": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"type": {"const": "region"}}}, "then": {"properties": {"value": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}}}},
        {"if": {"properties": {"type": {"const": "value"}}}, "then": {"not": {"required": ["unit"], "properties": {"unit": {"type": "null"}}}}},
        {"if": {"required": ["unit"]}, "then": {"properties": {"type": {"const": "value"}}}}
      ]
    }
  }
}

